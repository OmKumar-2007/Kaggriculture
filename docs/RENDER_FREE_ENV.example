# Render API Dashboard values; never commit populated secrets.
APP_ENV=production
QUEUE_BACKEND=postgres
FARMCRAFT_EVALUATOR_VERSION=2026.10.09
WORKER_REGISTRATION_ENABLED=1
LOAD_TEST_FAKE_SIMULATION=0
STORAGE_BACKEND=s3
DATABASE_URL=postgresql://USER:PASSWORD@NEON-POOLED-HOST/DB?sslmode=require
REDIS_URL=rediss://default:PASSWORD@UPSTASH-HOST:PORT
OBJECT_STORAGE_ENDPOINT=https://NEON-S3-ENDPOINT
OBJECT_STORAGE_BUCKET=PRIVATE-BUCKET
OBJECT_STORAGE_REGION=NEON-REGION
OBJECT_STORAGE_ACCESS_KEY=SET-IN-RENDER-DASHBOARD
OBJECT_STORAGE_SECRET_KEY=SET-IN-RENDER-DASHBOARD
ADMIN_PASSWORD_HASH=SET-IN-RENDER-DASHBOARD
ADMIN_SESSION_SECRET=GENERATED-BY-RENDER
PUBLIC_BASE_URL=https://farmcraft-free-web.onrender.com
CORS_ORIGINS=https://farmcraft-free-web.onrender.com
