# Copy to .env only if you are configuring the host manually.
# Windows start-server.ps1 creates this file and its secrets for you.
POSTGRES_PASSWORD=replace-with-random-hex
ADMIN_PASSWORD_HASH='pbkdf2_sha256$310000$replace-salt$replace-hash'
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
FARMCRAFT_BIND_IP=0.0.0.0
FARMCRAFT_PORT=8000
MAX_EVALUATION_WORKERS=2
EVALUATION_TIMEOUT_SECONDS=120
EVALUATION_MEMORY_MB=512
EVALUATION_CPU_LIMIT=1
EVALUATION_PIDS_LIMIT=128
MAX_SUBMISSION_SIZE_KB=256
MAX_PARTICIPANTS=100
MAX_ACTIVE_SANDBOX_PER_TEAM=1
MAX_ACTIVE_OFFICIAL_PER_TEAM=1
MAX_INFRASTRUCTURE_RETRIES=2
PARTICIPANT_HEARTBEAT_SECONDS=15
PARTICIPANT_IDLE_SECONDS=30
PARTICIPANT_OFFLINE_SECONDS=60
LOAD_TEST_FAKE_SIMULATION=0
